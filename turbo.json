{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["BUILD_STANDALONE"],
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "test"],
      "outputs": [
        "dist/**",
        "dist/*.js",
        "dist/*.d.ts",
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**"
      ]
    },
    "build:ci": {
      "dependsOn": ["^build:ci"],
      "outputs": [
        "dist/**",
        "dist/*.js",
        "dist/*.d.ts",
        ".next/**",
        "!.next/cache/**",
        "**/generated/**",
        "storybook-static/**",
        ".react-email/**"
      ]
    },
    "test": {
      "dependsOn": ["@36node/stargate-next-sdk#build:ci", "^test"]
    },
    "typecheck": {
      "dependsOn": ["@36node/stargate-next-sdk#build:ci", "^typecheck"]
    },
    "analyze": {
      "dependsOn": ["^analyze"]
    },
    "dev": {
      "dependsOn": ["@36node/stargate-next-sdk#build:ci"],
      "cache": false,
      "persistent": true
    },
    "translate": {
      "dependsOn": ["^translate"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    }
  }
}
