{
  "name": "@repo/redis",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup index.ts --format cjs --dts --clean",
    "build:ci": "tsup index.ts --format cjs --dts --clean",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ioredis": "^5.10.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
