{
  "name": "@repo/stargate-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts.ts"
  },
  "scripts": {
    "cleanup:idempotency": "DOTENV_CONFIG_PATH=../../../.env tsx scripts/cleanup-idempotency.ts",
    "seed:default-tenant": "DOTENV_CONFIG_PATH=../../../.env tsx scripts/seed-default-tenant.ts",
    "seed:legacy-fixture": "DOTENV_CONFIG_PATH=../../../.env tsx scripts/seed-legacy-fixture.ts",
    "test": "vitest run --exclude 'test/**/*.integration.spec.ts'",
    "test:integration": "vitest run test/account.integration.spec.ts test/auth.integration.spec.ts test/tenant.integration.spec.ts test/tenant-api-key.integration.spec.ts test/redis-tenant.integration.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/redis": "workspace:*",
    "dotenv": "^17.4.2",
    "svg-captcha": "^1.4.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:toolchain",
    "tsx": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:toolchain"
  }
}
