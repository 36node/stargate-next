{
  "name": "@repo/db",
  "version": "1.2.0",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "analyze": "prisma generate",
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "build:ci": "prisma generate",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "push": "prisma db push",
    "push:force": "prisma db push --force-reset && prisma generate",
    "migrate:push": "prisma db push",
    "migrate:push:force": "prisma db push --force-reset",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:legacy-accounts": "tsx scripts/migrate-legacy-accounts.ts",
    "prisma": "prisma",
    "studio": "prisma studio",
    "test:migration": "vitest run scripts/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:backfill": "tsx scripts/verify-backfill-migration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.9.1",
    "dotenv": "^16.4.0",
    "mongodb": "^6.20.0",
    "pg": "^8.19.0",
    "zod": "catalog:zod"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "catalog:toolchain",
    "@types/pg": "^8.18.0",
    "prisma": "7.9.1",
    "tsx": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vitest": "catalog:toolchain"
  }
}
