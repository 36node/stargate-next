DATABASE_URL=postgresql://postgres:123456@localhost:5432/stargate-next-local?schema=public
REDIS_URL=redis://localhost:6379

# Stargate Next service
PORT=9527
LOG_LEVEL=info
STARGATE_ADMIN_API_KEY=playground-dev-admin-api-key
STARGATE_API_KEY=playground-dev-api-key
STARGATE_JWT_SECRET=playground-dev-jwt-secret
REFRESH_KEY_HMAC_PRIMARY_KEY_ID=primary-local
REFRESH_KEY_HMAC_PRIMARY_SECRET=replace-with-random-secret
# Optional refresh-key HMAC rotation pair; configure both values or neither.
# REFRESH_KEY_HMAC_SECONDARY_KEY_ID=secondary-local
# REFRESH_KEY_HMAC_SECONDARY_SECRET=replace-with-second-random-secret
TENANT_API_KEY_HMAC_PRIMARY_KEY_ID=tenant-primary-local
TENANT_API_KEY_HMAC_PRIMARY_SECRET=replace-with-random-tenant-key-secret
# Optional Tenant API Key HMAC rotation pair; configure both values or neither.
# TENANT_API_KEY_HMAC_SECONDARY_KEY_ID=tenant-secondary-local
# TENANT_API_KEY_HMAC_SECONDARY_SECRET=replace-with-second-tenant-key-secret
REDIS_KEY_PREFIX=stargate-next:
STARGATE_DEPLOY_TIER=development
CAPTCHA_TEST_MODE=true
CAPTCHA_TEST_CODE=ABCD
CAPTCHA_HMAC_SECRET=local-captcha-hmac-secret
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_CREATE_LIMIT=30
CAPTCHA_CREATE_WINDOW_SECONDS=60
CAPTCHA_TTL_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=3600
JWT_CLOCK_TOLERANCE_SECONDS=30
REFRESH_TTL_SECONDS=604800

# Playground server integration
STARGATE_AUTH_BACKEND=next
STARGATE_ENDPOINT=http://localhost:9527
# When Stargate uses RS256 tokens, set STARGATE_JWT_PUBLIC_KEY instead.
