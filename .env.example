DATABASE_URL=postgresql://postgres:123456@localhost:5432/stargate-next-local?schema=public
REDIS_URL=redis://localhost:6379

# Playground 服务端旧 Stargate 集成
STARGATE_ENDPOINT=https://auth.example.com
STARGATE_API_KEY=<stargate-api-key>
STARGATE_JWT_SECRET=<stargate-jwt-secret>
# 当 Stargate 使用 RS256 Token 时，请改为设置 STARGATE_JWT_PUBLIC_KEY。
