DATABASE_URL=postgresql://postgres:123456@localhost:5432/stargate-next-local?schema=public
REDIS_URL=redis://localhost:6379
REFRESH_KEY_HMAC_PRIMARY_KEY_ID=primary-local
REFRESH_KEY_HMAC_PRIMARY_SECRET=replace-with-random-secret
REDIS_KEY_PREFIX=stargate-next:
CAPTCHA_TEST_MODE=true
CAPTCHA_HMAC_SECRET=local-captcha-hmac-secret

# Playground 服务端旧 Stargate 集成
STARGATE_ENDPOINT=http://localhost:9527
STARGATE_API_KEY=playground-dev-api-key
STARGATE_JWT_SECRET=playground-dev-jwt-secret
# 当 Stargate 使用 RS256 Token 时，请改为设置 STARGATE_JWT_PUBLIC_KEY。
