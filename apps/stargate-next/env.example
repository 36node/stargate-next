DATABASE_URL=postgresql://postgres:123456@localhost:5432/stargate-next-local?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=stargate-next:
PORT=9527
STARGATE_ENDPOINT=http://127.0.0.1:9527

# Required secrets. Generate unique production values.
STARGATE_API_KEY=local-service-api-key
STARGATE_JWT_SECRET=local-jwt-secret
CAPTCHA_HMAC_SECRET=local-captcha-hmac-secret
REFRESH_KEY_HMAC_PRIMARY_KEY_ID=primary-2026
REFRESH_KEY_HMAC_PRIMARY_SECRET=local-refresh-primary-secret
# REFRESH_KEY_HMAC_SECONDARY_KEY_ID=previous-primary-2025
# REFRESH_KEY_HMAC_SECONDARY_SECRET=previous-refresh-secret

ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TTL_SECONDS=604800
CAPTCHA_TTL_SECONDS=300
CAPTCHA_MAX_ATTEMPTS=5
CAPTCHA_CREATE_LIMIT=30
CAPTCHA_CREATE_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=60

# Only enable in isolated integration tests. A 4-character alphanumeric
# CAPTCHA_TEST_CODE is required and used for every generated captcha.
# CAPTCHA_TEST_MODE=true
# CAPTCHA_TEST_CODE=ABCD
