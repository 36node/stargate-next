{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "plugins": [{ "name": "next" }],
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@/packages/ui": ["./packages/ui/index.tsx"],
      "@/packages/ui/*": ["./packages/ui/*"],
      "@/packages/lib/*": ["./packages/lib/*"],
      "@/packages/services/*": ["./packages/services/*"],
      "@/packages/next-stargate": ["./packages/next-stargate/src/index.ts"],
      "@/packages/next-stargate/*": ["./packages/next-stargate/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "packages/ui/.storybook/**/*.ts",
    "packages/ui/.storybook/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
