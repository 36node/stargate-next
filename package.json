{
  "name": "stargate-next-monorepo",
  "version": "0.1.0",
  "scripts": {
    "build": "turbo build",
    "build:ci": "turbo build:ci",
    "dev": "turbo dev --filter=playground --filter=stargate-next",
    "dev:stargate": "scripts/dev-stargate-legacy.sh",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "turbo test",
    "test:registry-config": "bash scripts/resolve-image-registry.test.sh",
    "typecheck": "turbo typecheck",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "pnpm -C apps/playground dlx shadcn@latest add --all --overwrite -c packages/ui",
    "clean": "git clean -xdf node_modules",
    "db:push": "pnpm --filter @repo/db push",
    "db:push:force": "pnpm --filter @repo/db push:force",
    "db:migrate": "pnpm --filter @repo/db migrate:deploy",
    "db:studio": "pnpm --filter @repo/db studio",
    "seed": "pnpm --filter stargate-next seed",
    "sdk:generate": "pnpm --filter @repo/stargate-next-sdk generate",
    "storybook": "pnpm -C apps/playground storybook",
    "postinstall": "scripts/setup-env.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.9.16",
    "@types/node": "catalog:toolchain",
    "dotenv": "^16.6.1",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "turbo": "^2.9.16",
    "typescript": "catalog:toolchain",
    "ultracite": "6.3.9",
    "vitest": "catalog:toolchain"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module"
}
