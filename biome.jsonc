{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react", "ultracite/next"],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "globals": ["Liveblocks"],
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "files": {
    "includes": [
      "**/*",
      "!apps/stargate",
      "!apps/playground/packages/ui/components/shadcn",
      "!apps/playground/packages/ui/lib",
      "!apps/playground/packages/ui/hooks",
      "!packages/collaboration/config.ts",
      "!packages/cms/basehub-types.d.ts",
      // 排除框架自动生成的代码检查
      "!packages/db/generated",
      "!packages/stargate-next-sdk/src/generated.ts",
      "!packages/stargate-next-sdk/src/openapi.ts"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "noLeakedRender": "off"
      },
      "performance": {
        "noBarrelFile": "off"
      }
    }
  }
}
